#!/usr/bin/env bash
# A stand-in for the AWS CLI, so test/commands_test.sh can run whole commands
# without an account. Prints what the real CLI would print for the queries in
# ssm.sh, and records every call in $SSM_TEST_CALLS so a test can assert what
# was asked for.
set -u

all="$*"

if [[ -n "${SSM_TEST_CALLS:-}" ]]; then
  echo "aws $all" >> "$SSM_TEST_CALLS"
fi

# A profile the tests did not set up: the real CLI fails, and both scripts have
# to surface that rather than treating it as "no results".
if [[ -n "${SSM_TEST_AWS_FAIL:-}" && "$all" == *"--profile $SSM_TEST_AWS_FAIL"* ]]; then
  echo "An error occurred (AuthFailure) calling the operation" >&2
  exit 255
fi

case "$1 $2" in
  'ec2 describe-instances')
    # list_apps filters on instance state only; list_instances adds a tag
    # filter, and that is what tells the two calls apart. Every row carries the
    # Environment tag last, None where an instance has none.
    if [[ "$all" == *'Name=tag:App'* ]]; then
      app=$(printf '%s\n' "$all" | sed -n 's/.*Name=tag:App,Values=\([^ ]*\).*/\1/p')
      case "$app" in
        # The same app in two environments: picking one must never reach the
        # other's instance.
        adam)
          printf 'i-0adam000000000009\tadam-prod-1\tproduction\n'
          printf 'i-0adam000000000001\tadam-web-1\tstaging\n'
          ;;
        beatrice)
          printf 'i-0bea000000000001\tbea-web-1\tstaging\n'
          printf 'i-0bea000000000002\tbea-web-2\tstaging\n'
          ;;
        # An app with instances but no RDS behind it, and no Environment tag.
        charlie) printf 'i-0cha000000000001\tcha-web-1\tNone\n' ;;
      esac
    else
      # One "Environment<TAB>App" row per instance: what --output text gives
      # for a list of pairs. None where a tag is missing, duplicates where an
      # app has several instances, and an instance with no App tag at all.
      printf 'staging\tadam\n'
      printf 'production\tadam\n'
      printf 'staging\tbeatrice\n'
      printf 'staging\tbeatrice\n'
      printf 'None\tcharlie\n'
      printf 'staging\tNone\n'
    fi
    ;;
  'rds describe-db-instances')
    app=$(printf '%s\n' "$all" | sed -n "s/.*Value=='\([^']*\)'.*/\1/p")
    case "$app" in
      adam)
        printf 'adam-prod-db\tadam-prod-db.rds.amazonaws.com\t5432\tproduction\n'
        printf 'adam-db\tadam-db.rds.amazonaws.com\t5432\tstaging\n'
        ;;
      beatrice)
        printf 'bea-db\tbea-db.rds.amazonaws.com\t5432\tstaging\n'
        printf 'bea-replica\tbea-replica.rds.amazonaws.com\t5432\tstaging\n'
        ;;
    esac
    ;;
  'resourcegroupstaggingapi get-resources')
    # dora runs on ECS only, in two environments: "ARN<TAB>App<TAB>Environment".
    printf 'arn:aws:ecs:ap-southeast-5:111122223333:service/apps/dora-stg\tdora\tstaging\n'
    printf 'arn:aws:ecs:ap-southeast-5:111122223333:service/apps/dora-prd\tdora\tproduction\n'
    ;;
  # No EKS in the fixture account, and dora has no running tasks: an empty
  # answer is the shape a quiet account gives.
  'ecs list-clusters' | 'ecs list-services' | 'ecs describe-services' | \
    'ecs list-container-instances' | 'ecs describe-tasks' | 'ecs list-tasks' | \
    'eks list-clusters') ;;
  'ssm start-session')
    # The real one hands over an interactive session; the tests only need to
    # know it was reached, and with which target.
    target=$(printf '%s\n' "$all" | sed -n 's/.*--target \([^ ]*\).*/\1/p')
    echo "STUB session to $target"
    # What the hosts file looked like while the tunnel was up, for the tests
    # that check ssm db added its line before connecting.
    if [[ -n "${SSM_HOSTS_FILE:-}" && -f "$SSM_HOSTS_FILE" ]]; then
      cp "$SSM_HOSTS_FILE" "$HOME/hosts-during-session"
    fi
    ;;
  'configure set')
    printf '%s\n' "$all" >> "$HOME/.aws-stub-writes"
    ;;
  'configure get')
    # Nothing is configured unless a `configure set` in this test wrote it.
    key="$3"
    profile=$(printf '%s\n' "$all" | sed -n 's/.*--profile \([^ ]*\).*/\1/p')
    if [[ -f "$HOME/.aws-stub-writes" ]] &&
      grep -q "set $key .* --profile $profile" "$HOME/.aws-stub-writes"; then
      grep "set $key .* --profile $profile" "$HOME/.aws-stub-writes" |
        tail -1 | sed "s/.*set $key \(.*\) --profile.*/\1/"
    else
      exit 1
    fi
    ;;
  *) ;;
esac
exit 0
